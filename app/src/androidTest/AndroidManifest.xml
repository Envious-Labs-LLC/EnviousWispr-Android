<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="com.envi.wispr.PasteTargetActivity"
            android:exported="true"
            android:label="Paste target" />
        <!--
            A speaker has no reason to have a screen. Without this theme it inherits the
            application's solid light one and paints white over whatever app the dictation is
            being tested against, which both hides the phone and changes what is on screen while
            the insertion path is being measured.
        -->
        <!--
            showWhenLocked and turnScreenOn are TEST-ONLY and live only in this manifest. They let the
            speaker play while the phone sits on its own lock screen, which is the difference between
            being able to measure the audio path at all and needing the founder's PIN for every run. The
            shipping app declares neither: an app that draws over a secure lock is a security decision,
            and a test rig is not the place to make it.
        -->
        <activity
            android:name="com.envi.wispr.SpeakerPlaybackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Speaker playback"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.envi.wispr.ClipboardPasteTargetActivity"
            android:exported="true"
            android:label="Clipboard paste target"
            android:launchMode="singleTask" />
    </application>
</manifest>
