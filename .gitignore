# Build outputs
.gradle/
.kotlin/
.cxx/
build/
app/build/
llama-android/build/
accelerator-benchmark/build/
local.properties

# IDE
.idea/
*.iml

# OS
.DS_Store

# Binary libs — too large for git. The whole directory, so an unpacked archive
# cannot slip through as a directory beside the file pattern.
app/libs/

# Local operating harness — not part of the product.
# Directory forms are ignored alongside the file forms on purpose: a pattern that
# matches only a file lets a directory of the same private kind through silently.
.claude/
CLAUDE.md
CLAUDE/
AGENTS.md
AGENTS/
.mcp.json
.mcp/
.beads/
.dolt/
*.db

# Local device and bridge tooling — belongs to the phone-workstation project, not the app
android-bridge/
android-mcp/
mac-bridge/
mac-mcp/
capabilities.json
capabilities/
scripts/brain-*

# Internal-only documents. One directory, so a new internal doc is private by
# default instead of needing its own line here.
docs/internal/

# Temp
.temp/
.git-private-archive/
